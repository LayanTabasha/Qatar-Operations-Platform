{
  "name": "qatar-operations-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 backend foundation for the Qatar Operations Platform.",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:auth-local": "node src/scripts/verify-auth-local.js",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "node src/db/migrate.js",
    "seed:roles": "node src/db/seed-roles.js",
    "seed": "node src/db/seed.js",
    "user:create": "node src/db/create-user.js",
    "user:create-admin": "node src/db/create-user.js --role=admin",
    "seed:admin": "node src/db/create-admin.js",
    "create-admin": "node src/db/create-admin.js",
    "faults:import": "node src/scripts/import-browser-faults.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
