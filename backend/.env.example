NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/qatar_operations
DATABASE_SSL=false
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=qatar_ops_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SITE_IMAGE_UPLOAD_ROOT=/var/www/qatar-operations/uploads/site-images
ADMIN_NAME=Zeeda Energy Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production example values. Do not paste real secrets into this file.
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://qatar_ops_user:CHANGE_ME@localhost:5432/qatar_operations
# DATABASE_SSL=false
# FRONTEND_ORIGIN=https://YOUR_DOMAIN_HERE
# LOG_LEVEL=info
# TRUST_PROXY=true
# JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# JWT_EXPIRES_IN=8h
